# Konfigurasi Google Firebase untuk UPB Microsite
# Dapatkan nilai ini dari Firebase Console -> Project Settings -> General -> Your apps -> Web app config

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=upb-microsite.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=upb-microsite
VITE_FIREBASE_STORAGE_BUCKET=upb-microsite.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
