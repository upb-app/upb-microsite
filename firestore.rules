rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'superadmin' ||
        getUserData().role == 'superadmin'
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Koleksi Users: Hanya Superadmin yang bisa mengelola seluruh user
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }

    // Koleksi Microsite Config & Published Microsites (Akses Publik Global)
    match /published_microsites/{slug} {
      allow read: if true;
      allow write: if true;
    }

    match /microsites_registry/{siteId} {
      allow read: if true;
      allow write: if true;
    }

    match /microsites/{micrositeId} {
      allow read: if true;
      allow write: if true;
    }

    // Koleksi Security Audit Logs
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Koleksi Analytics
    match /analytics_events/{eventId} {
      allow read, write: if true;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
